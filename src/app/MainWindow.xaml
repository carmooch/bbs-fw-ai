<Window x:Class="BBSFW.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BBS-FW-AI" Width="1440" Height="900" MinWidth="1100" MinHeight="680"
        Background="{StaticResource Bg}" UseLayoutRounding="True">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <Style x:Key="Group" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Muted}" />
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="10,16,0,6" />
    </Style>
    <Style x:Key="LiveLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Muted}" />
      <Setter Property="FontSize" Value="10" />
    </Style>
    <Style x:Key="LiveValue" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource Mono}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="56" />
      <RowDefinition Height="*" />
      <RowDefinition Height="54" />
    </Grid.RowDefinitions>

    <!-- header -->
    <Border Grid.Row="0" Background="{StaticResource Bar}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
      <DockPanel Margin="18,0" LastChildFill="False">
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,18,0">
          <Border Width="22" Height="22" CornerRadius="6">
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#7B95FF" Offset="0" /><GradientStop Color="#4FD1C5" Offset="1" /></LinearGradientBrush>
            </Border.Background>
          </Border>
          <TextBlock Text="BBS-FW-AI" FontWeight="Bold" FontSize="14" Margin="9,0,0,0" VerticalAlignment="Center" />
        </StackPanel>
        <Border DockPanel.Dock="Left" Background="#171C23" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="9" Padding="3" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal">
            <RadioButton x:Name="TabBaseline" Style="{StaticResource Segment}" GroupName="tune" Checked="Tab_Checked" Content="{Binding BaselineLabel}" />
            <RadioButton x:Name="TabWorking" Style="{StaticResource Segment}" GroupName="tune" Checked="Tab_Checked" IsChecked="True">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="Working copy" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                <TextBlock Text="{Binding ChangeCount, StringFormat='  ● {0}'}" Foreground="{StaticResource ChangedDot}" FontFamily="{StaticResource Mono}" />
              </StackPanel>
            </RadioButton>
          </StackPanel>
        </Border>

        <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Review &amp; write" Margin="10,0,0,0" VerticalAlignment="Center" Click="Review_Click" IsEnabled="{Binding CanWrite}" />
        <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Content="Save tune as…" Margin="8,0,0,0" VerticalAlignment="Center" Click="Save_Click" IsEnabled="{Binding HasTune}" />
        <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Content="Open tune…" Margin="8,0,0,0" VerticalAlignment="Center" Click="Open_Click" />
        <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Content="{Binding ConnectLabel}" Margin="8,0,0,0" VerticalAlignment="Center" Click="Connect_Click" />
        <ComboBox DockPanel.Dock="Right" Width="90" Height="30" VerticalAlignment="Center" ItemsSource="{Binding Ports}" SelectedItem="{Binding Port}" DisplayMemberPath="Name" DropDownOpened="Ports_Opened" ToolTip="Cable port" />
        <TextBlock DockPanel.Dock="Right" Text="{Binding Status}" Foreground="{StaticResource Text2}" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0" MaxWidth="420" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}" />
      </DockPanel>
    </Border>

    <!-- body -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="214" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="284" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="{StaticResource Nav}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
        <StackPanel Margin="10,8">
          <TextBlock Style="{StaticResource Group}" Text="ASSIST" />
          <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Tag="Standard" Content="Standard map" IsChecked="True" Checked="Nav_Checked" />
          <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Tag="Sport" Content="Sport map" Checked="Nav_Checked" />
          <TextBlock Style="{StaticResource Group}" Text="POWER" />
          <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Tag="-" Content="Motor &amp; battery" Checked="Nav_Checked" />
          <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Tag="-" Content="Throttle" Checked="Nav_Checked" />
          <TextBlock Style="{StaticResource Group}" Text="FEEL" />
          <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Tag="-" Content="Pedal timing &amp; feel" Checked="Nav_Checked" />
          <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Tag="-" Content="Effort sensing" Checked="Nav_Checked" />
          <TextBlock Style="{StaticResource Group}" Text="HARDWARE" />
          <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Tag="-" Content="Sensors &amp; lights" Checked="Nav_Checked" />
          <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Tag="-" Content="Display" Checked="Nav_Checked" />
          <TextBlock Style="{StaticResource Group}" Text="DATA" />
          <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Tag="-" Content="Datalogs" Checked="Nav_Checked" />
          <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Tag="-" Content="Backups" Checked="Nav_Checked" />
        </StackPanel>
      </Border>

      <!-- main -->
      <Grid Grid.Column="1" Margin="22,18">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,14" LastChildFill="False">
          <TextBlock x:Name="PageTitle" DockPanel.Dock="Left" Text="Standard map" FontSize="19" FontWeight="Bold" VerticalAlignment="Center" />
          <TextBlock x:Name="PageHint" DockPanel.Dock="Left" Text="Select a row to shape it · drag points or type in cells" Foreground="{StaticResource Muted}" FontSize="12" Margin="12,0,0,0" VerticalAlignment="Center" />
          <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Content="Discard changes" Click="Discard_Click" IsEnabled="{Binding HasTune}" />
        </DockPanel>

        <!-- nothing loaded -->
        <Border x:Name="EmptyPanel" Grid.Row="1" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="14" Padding="40" VerticalAlignment="Top">
          <StackPanel>
            <TextBlock Text="Connect to your bike, or open a tune" FontSize="17" FontWeight="SemiBold" />
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Text2}" Margin="0,8,0,0" MaxWidth="640" HorizontalAlignment="Left"
                       Text="Plug the cable's USB end in first, then the motor end, battery on, and press Connect. Or open a saved tune or a backup (.xml) to explore it without the bike." />
          </StackPanel>
        </Border>

        <!-- section not built yet -->
        <Border x:Name="NotYetPanel" Grid.Row="1" Visibility="Collapsed" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="14" Padding="40" VerticalAlignment="Top">
          <StackPanel>
            <TextBlock Text="Not in BBS-FW-AI yet" FontSize="17" FontWeight="SemiBold" />
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Text2}" Margin="0,8,0,0" MaxWidth="640" HorizontalAlignment="Left"
                       Text="This first build has the assist maps. Use BBSFWTool for this section for now; it's still there, unchanged." />
          </StackPanel>
        </Border>

        <!-- the map: chart and table share the same nine level columns -->
        <Border x:Name="MapPanel" Grid.Row="1" Visibility="Collapsed" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="14" VerticalAlignment="Top" ClipToBounds="True">
          <StackPanel>
            <Grid Height="266">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <DockPanel Grid.Column="0" Margin="14,14,14,10">
                <StackPanel DockPanel.Dock="Top">
                  <TextBlock x:Name="ChartTitle" Text="Current" FontWeight="SemiBold" FontSize="13" />
                  <TextBlock x:Name="ChartUnit" Text="amps" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0" />
                </StackPanel>
                <Grid x:Name="AxisLabels" />
              </DockPanel>
              <Canvas x:Name="Chart" Grid.Column="1" Background="Transparent" ClipToBounds="True"
                      MouseLeftButtonDown="Chart_Down" MouseMove="Chart_Move" MouseLeftButtonUp="Chart_Up" SizeChanged="Chart_SizeChanged" Cursor="SizeNS" />
            </Grid>
            <Grid Height="30">
              <Grid.ColumnDefinitions><ColumnDefinition Width="200" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <TextBlock Text="LEVEL" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="14,0,0,0" />
              <UniformGrid Grid.Column="1" Columns="9" x:Name="LevelHeader" />
            </Grid>
            <ItemsControl ItemsSource="{Binding Rows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border x:Name="rowb" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Height="36">
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="200" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                      <Border x:Name="lab" Background="Transparent" Cursor="Hand" MouseLeftButtonDown="Row_Click" Tag="{Binding}">
                        <DockPanel Margin="14,0,12,0">
                          <TextBlock x:Name="labtext" Text="{Binding Label}" Foreground="{StaticResource Text2}" FontSize="13" VerticalAlignment="Center" />
                          <TextBlock Text="{Binding Note}" Foreground="{StaticResource Muted}" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Right" />
                        </DockPanel>
                      </Border>
                      <ItemsControl Grid.Column="1" ItemsSource="{Binding Cells}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="9" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Grid ToolTip="{Binding Tooltip}">
                              <TextBox x:Name="box" Style="{StaticResource CellBox}" Text="{Binding Text, UpdateSourceTrigger=LostFocus}" Tag="{Binding}"
                                       IsReadOnly="True" LostKeyboardFocus="Cell_LostFocus" KeyDown="Cell_KeyDown" Margin="4,3" />
                              <Ellipse x:Name="dot" Width="6" Height="6" Fill="{StaticResource ChangedDot}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,8,0" Visibility="Collapsed" IsHitTestVisible="False" />
                            </Grid>
                            <DataTemplate.Triggers>
                              <DataTrigger Binding="{Binding Editable}" Value="True"><Setter TargetName="box" Property="IsReadOnly" Value="False" /></DataTrigger>
                              <DataTrigger Binding="{Binding Muted}" Value="True"><Setter TargetName="box" Property="Foreground" Value="#7E8A9A" /></DataTrigger>
                              <DataTrigger Binding="{Binding Changed}" Value="True">
                                <Setter TargetName="box" Property="Foreground" Value="{StaticResource Changed}" />
                                <Setter TargetName="box" Property="FontWeight" Value="SemiBold" />
                                <Setter TargetName="dot" Property="Visibility" Value="Visible" />
                              </DataTrigger>
                            </DataTemplate.Triggers>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </Grid>
                  </Border>
                  <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Selected}" Value="True">
                      <Setter TargetName="lab" Property="Background" Value="{StaticResource SelectedRow}" />
                      <Setter TargetName="lab" Property="BorderBrush" Value="{StaticResource Accent}" />
                      <Setter TargetName="lab" Property="BorderThickness" Value="3,0,0,0" />
                      <Setter TargetName="labtext" Property="Foreground" Value="White" />
                      <Setter TargetName="labtext" Property="FontWeight" Value="SemiBold" />
                    </DataTrigger>
                  </DataTemplate.Triggers>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </Grid>

      <!-- inspector and changes -->
      <Border Grid.Column="2" Background="{StaticResource Nav}" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0" Padding="18,16">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="CHANGES IN THE WORKING COPY" Foreground="{StaticResource Muted}" FontSize="10.5" FontWeight="SemiBold" />
          <TextBlock DockPanel.Dock="Top" x:Name="NoChanges" Text="None yet. Edit a cell or drag a point." Foreground="{StaticResource Text2}" FontSize="12.5" Margin="0,10,0,0" TextWrapping="Wrap" />
          <TextBlock DockPanel.Dock="Bottom" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,12,0,0"
                     Text="Nothing reaches the bike until Review &amp; write. Writing needs the bike still, saves a backup first and reads the settings back." />
          <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
            <ItemsControl x:Name="ChangeList">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,8">
                    <StackPanel>
                      <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" />
                      <TextBlock FontFamily="{StaticResource Mono}" FontSize="12" Foreground="{StaticResource Text2}">
                        <Run Text="{Binding Before, Mode=OneWay}" /><Run Text=" → " /><Run Text="{Binding After, Mode=OneWay}" Foreground="{StaticResource Changed}" />
                      </TextBlock>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>

    <!-- live strip -->
    <Border Grid.Row="2" Background="{StaticResource Bar}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
      <StackPanel Orientation="Horizontal">
        <StackPanel Margin="16,9" Width="90"><TextBlock Style="{StaticResource LiveLabel}" Text="LEVEL" /><TextBlock Style="{StaticResource LiveValue}" Text="{Binding LiveLevel}" /></StackPanel>
        <StackPanel Margin="16,9" Width="100"><TextBlock Style="{StaticResource LiveLabel}" Text="CADENCE" /><TextBlock Style="{StaticResource LiveValue}" Text="{Binding LiveCadence}" /></StackPanel>
        <StackPanel Margin="16,9" Width="110"><TextBlock Style="{StaticResource LiveLabel}" Text="SPEED" /><TextBlock Style="{StaticResource LiveValue}" Text="{Binding LiveSpeed}" /></StackPanel>
        <StackPanel Margin="16,9" Width="100"><TextBlock Style="{StaticResource LiveLabel}" Text="BATTERY CURRENT" /><TextBlock Style="{StaticResource LiveValue}" Text="{Binding LiveMotor}" /></StackPanel>
        <StackPanel Margin="16,9" Width="130"><TextBlock Style="{StaticResource LiveLabel}" Text="BATTERY" /><TextBlock Style="{StaticResource LiveValue}" Text="{Binding LiveBattery}" /></StackPanel>
        <StackPanel Margin="16,9" Width="80"><TextBlock Style="{StaticResource LiveLabel}" Text="TEMP" /><TextBlock Style="{StaticResource LiveValue}" Text="{Binding LiveTemp}" /></StackPanel>
        <StackPanel Margin="16,9" Width="90"><TextBlock Style="{StaticResource LiveLabel}" Text="LEARNED" /><TextBlock Style="{StaticResource LiveValue}" Text="{Binding LiveLearned}" Foreground="#FFB46B" /></StackPanel>
        <StackPanel Margin="16,9"><TextBlock Style="{StaticResource LiveLabel}" Text="STATE" /><TextBlock Style="{StaticResource LiveValue}" Text="{Binding StillText}" Foreground="{StaticResource Ok}" /></StackPanel>
      </StackPanel>
    </Border>
  </Grid>
</Window>
