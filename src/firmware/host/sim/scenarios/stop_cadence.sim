title Stop pedalling from 40 rpm and from 90 rpm (level 3)

at 1000 cadence 40 over 500
at 4000 cadence 0
at 6000 cadence 90 over 500
at 9000 cadence 0

end 10000

# Predictive stop: assist is cut ~85ms after stopping from 40 rpm and ~50ms
# from 90 rpm (upstream: 160ms and 195ms). The second start is rolling, so
# it needs only 2 pulses.
expect 4000 current > 0
expect 4150 current == 0
expect 6200 current > 0
expect 9000 current > 0
expect 9100 current == 0
